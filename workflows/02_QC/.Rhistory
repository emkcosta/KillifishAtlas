#!/usr/bin/env Rscript
suppressPackageStartupMessages({
library(optparse); library(yaml); library(readr); library(dplyr); library(purrr); library(rlang)
})
`%||%` <- function(a,b) if (!is.null(a)) a else b
opt_list <- list(make_option(c('-c','--config'), type='character', default='configs/default.yaml'))
opt <- parse_args(OptionParser(option_list = opt_list))
cfg <- yaml::read_yaml(opt$config)
getwd()
opt_list <- list(make_option(c('-c','--config'), type='character', default='../../configs/default.yaml'))
opt <- parse_args(OptionParser(option_list = opt_list))
cfg <- yaml::read_yaml(opt$config)
manifest_path <- cfg$paths$featurecounts_manifest %||% 'workflows/01_GetCounts/Input/manifest.tsv'
out_matrix    <- cfg$paths$combined_matrix       %||% 'workflows/01_GetCounts/Output/combined_matrix.tsv'
message('Reading manifest: ', manifest_path)
man <- readr::read_tsv(manifest_path, show_col_types = FALSE)
stopifnot(all(c('sample_id','featurecounts_path') %in% colnames(man)))
cfg
opt_list
